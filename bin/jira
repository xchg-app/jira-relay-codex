#!/usr/bin/env python3
"""Jira for agents, through a jira-relay service over HTTPS. Stdlib only.

    jira get DEMO-42 --as backend
    jira comment DEMO-42 --as backend <<'TXT'
    Fixed the export, ready to check.
    TXT
    jira --help
    jira setup https://jira-relay.example.com:8443   # once: where the service is; pins its certificate
    jira register [--jira SITE]                      # once, by the human: their Jira token → a service token

Read freely, change only on your human's command (skills/jira/SKILL.md). The service parses commands: this client only
builds the request (arguments, text from stdin, files for attach) and delivers it. Settings live in
~/.config/jira-relay/client.conf (url, fingerprint, token; mode 0600) or JIRA_RELAY_URL / JIRA_RELAY_TOKEN.
The service's certificate is self-signed: `jira setup` remembers its SHA-256 fingerprint (trust on first use, like
ssh), every request checks it; the admin announces the fingerprint (`jira-relay tls`) so the human can compare.
The service token identifies the human: the service never takes a login from the request.
"""
import base64
import getpass
import hashlib
import json
import os
import select
import ssl
import sys
from http.client import HTTPException, HTTPSConnection
from pathlib import Path
from urllib.parse import urlsplit

CONFIG = Path(os.environ.get('XDG_CONFIG_HOME', '~/.config')).expanduser() / 'jira-relay' / 'client.conf'
VERSION = '0.6.0'  # jira-relay version this client and skill came with; set by bin/release
TIMEOUT = 180


def parse_version(value) -> tuple[int, ...]:
    try:
        return tuple(int(p) for p in str(value).split('.'))
    except ValueError:
        return ()


def warn_if_outdated(service: str | None) -> None:
    """Service newer than the client means the SKILL.md next to it is outdated too: the agent will miss new commands and rules."""
    if service and parse_version(service) > parse_version(VERSION):
        print(f'jira: jira-relay service is {service}, but this client is {VERSION} — update the jira-relay '
              f'plugin/extension of your agent', file=sys.stderr)


def load_settings() -> dict:
    """client.conf (key=value), overridden by JIRA_RELAY_URL / JIRA_RELAY_TOKEN."""
    settings = {}
    try:
        for line in CONFIG.read_text().splitlines():
            key, sep, value = line.partition('=')
            if sep and not key.strip().startswith('#'):
                settings[key.strip()] = value.strip()
    except OSError:
        pass
    for key, env in (('url', 'JIRA_RELAY_URL'), ('token', 'JIRA_RELAY_TOKEN')):
        if os.environ.get(env):
            settings[key] = os.environ[env]
    return settings


def save_settings(settings: dict) -> None:
    CONFIG.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(CONFIG, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, 'w') as handle:
        handle.write(''.join(f'{k}={v}\n' for k, v in settings.items() if v))


def fail(message: str) -> int:
    print(f'jira: {message}', file=sys.stderr)
    return 1


class ServiceError(Exception):
    pass


def fingerprint(der: bytes) -> str:
    digest = hashlib.sha256(der).hexdigest().upper()
    return ':'.join(digest[i:i + 2] for i in range(0, len(digest), 2))


def connect(url: str, pinned: str) -> tuple[HTTPSConnection, str]:
    """TLS to the service; the certificate must match the pinned fingerprint (empty: first use, returned)."""
    parts = urlsplit(url)
    if parts.scheme != 'https' or not parts.hostname:
        raise ServiceError(f'the service URL must be https://host[:port] (got {url})')
    context = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
    context.check_hostname, context.verify_mode = False, ssl.CERT_NONE  # a self-signed certificate: pinned instead
    conn = HTTPSConnection(parts.hostname, parts.port or 443, context=context, timeout=TIMEOUT)
    try:
        conn.connect()
    except (OSError, HTTPException) as e:
        raise ServiceError(f'cannot reach the jira-relay service at {url}: {e}') from None
    seen = fingerprint(conn.sock.getpeercert(binary_form=True))
    if pinned and seen.replace(':', '').casefold() != pinned.replace(':', '').casefold():
        conn.close()
        raise ServiceError(f'the certificate of {url} changed: SHA-256 {seen}, pinned {pinned}. If the admin '
                           f'reissued it, run `jira setup {url}` again; otherwise do not continue')
    return conn, seen


def call(settings: dict, method: str, path: str, body=None, token: str = '') -> dict:
    """One request. Without a pinned fingerprint (setup) the certificate seen is put into the settings."""
    url = settings.get('url')
    if not url:
        raise ServiceError('the jira-relay service is not set: ask your human where it runs, then jira setup URL')
    conn, settings['fingerprint'] = connect(url, settings.get('fingerprint', ''))
    headers = {'Content-Type': 'application/json'}
    if token:
        headers['Authorization'] = f'Bearer {token}'
    try:
        conn.request(method, path, json.dumps(body, ensure_ascii=False).encode() if body is not None else None, headers)
        response = conn.getresponse()
        raw = response.read()
    except TimeoutError:
        raise ServiceError(f'{url} did not answer in {TIMEOUT} s; a change may have gone through — '
                           f'check: jira log --since 1h') from None
    except (OSError, HTTPException) as e:
        raise ServiceError(f'{url}: {e}') from None
    finally:
        conn.close()
    try:
        reply = json.loads(raw)
    except ValueError:
        raise ServiceError(f'{url} replied with non-JSON ({response.status}): is that the jira-relay gateway?') from None
    warn_if_outdated(reply.get('version'))
    return reply


def setup(args: list[str]) -> int:
    """`jira setup URL [--fingerprint SHA256]`: pins the service certificate and checks the service answers."""
    usage = 'usage: jira setup https://HOST[:PORT] [--fingerprint SHA256]  (the jira-relay gateway; port 8443 by default)'
    if not args or args[0].startswith('-'):
        return fail(usage)
    url, expected = args[0].rstrip('/'), ''
    if args[1:2] == ['--fingerprint'] and len(args) == 3:
        expected = args[2]
    elif len(args) != 1:
        return fail(usage)
    settings = load_settings()
    # the fingerprint to check: the given one, else the pinned one of the same URL (a change is reported, not adopted)
    pin = expected or (settings.get('fingerprint', '') if settings.get('url') == url else '')
    settings.update(url=url, fingerprint=pin)
    try:
        reply = call(settings, 'GET', '/version')
    except ServiceError as e:
        return fail(str(e))
    save_settings(settings)
    seen = settings['fingerprint']
    print(f'jira: {url} is jira-relay {reply.get("version")}, certificate SHA-256 {seen}\n'
          f'jira: saved to {CONFIG}. Compare the fingerprint with what the jira-relay admin announced; '
          f'then register: jira register')
    return 0


def register(args: list[str]) -> int:
    """`jira register [--jira SITE]`: the human's Jira token → the service token. Only in a terminal: the token is
    typed, never passed by an agent."""
    site = ''
    if args[:1] == ['--jira'] and len(args) == 2:
        site = args[1]
    elif args:
        return fail('usage: jira register [--jira SITE]')
    if not sys.stdin.isatty():
        return fail('register is done by your human in their own terminal: it asks for their Jira token')
    settings = load_settings()
    if not settings.get('url'):
        return fail('the jira-relay service is not set: jira setup URL first')
    token = getpass.getpass('Jira Personal Access Token (hidden): ').strip()
    if not token:
        return fail('no token given')
    try:
        reply = call(settings, 'POST', '/register', {'site': site, 'token': token})
    except ServiceError as e:
        return fail(str(e))
    if not reply.get('ok'):
        return fail(reply.get('error') or 'registration refused')
    settings['token'] = reply['token']
    save_settings(settings)
    print(f'jira: registered as {reply["login"]}; the service token is in {CONFIG}. Agents can work now: '
          f'jira sites --as <project>')
    return 0


def read_stdin() -> str:
    """Text from a heredoc or a pipe. An open but empty stdin (happens with agents) is not waited on."""
    if sys.stdin is None or sys.stdin.closed or sys.stdin.isatty():
        return ''
    ready, _, _ = select.select([sys.stdin], [], [], 1.0)
    return sys.stdin.read() if ready else ''


def main() -> int:
    # --as anywhere: `jira get DEMO-1 --as backend`. This way a Claude Code read permission is a command prefix
    # (`bin/jira get:*`) and the agent name does not break it
    argv, name, rest = sys.argv[1:], '', []
    i = 0
    while i < len(argv):
        if argv[i] == '--as':
            if i + 1 >= len(argv):
                return fail('--as: the agent project name is required')
            name, i = argv[i + 1], i + 2
            continue
        if argv[i].startswith('--as='):
            name = argv[i][5:]
        else:
            rest.append(argv[i])
        i += 1
    argv = rest
    if not argv:
        argv = ['--help']
    if argv[:1] == ['setup']:
        return setup(argv[1:])
    if argv[:1] == ['register']:
        return register(argv[1:])
    if argv == ['--version']:
        print(f'jira {VERSION}')
        return 0

    # the command words without the global --jira option (the gateway reads it anywhere in argv)
    words = [i for i, a in enumerate(argv)
             if not a.startswith('--jira=') and a != '--jira' and not (i and argv[i - 1] == '--jira')]
    command = [argv[i] for i in words[:2]]
    files = {}
    if command[:1] == ['attach']:
        for i in words[2:]:
            arg = argv[i]
            path = Path(arg).expanduser()
            try:
                files[path.name] = base64.b64encode(path.read_bytes()).decode()
            except OSError as e:
                return fail(f'{arg}: {e.strerror}')
            argv[i] = path.name
    help_only = any(a in ('-h', '--help') for a in argv)
    if command == ['token', 'set'] and not help_only and sys.stdin.isatty():
        text = getpass.getpass('Jira Personal Access Token (hidden): ')
    else:
        text = '' if help_only else read_stdin()
    request = {'as': name, 'argv': argv, 'text': text, 'files': files}

    settings = load_settings()
    if not settings.get('token'):
        return fail('not registered with the jira-relay service: your human runs `jira register` in their terminal')
    try:
        reply = call(settings, 'POST', '/agent', request, token=settings['token'])
    except ServiceError as e:
        return fail(str(e))
    if reply.get('ok'):
        out = reply.get('out') or ''
        print(out, end='' if out.endswith('\n') else '\n')
        return 0
    return fail(reply.get('error') or 'error without text')


if __name__ == '__main__':
    sys.exit(main())
